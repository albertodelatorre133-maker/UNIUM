# Credenciales del proyecto de Supabase.
# Copia este archivo como .env.local y pega los valores de
# Supabase -> Project Settings -> API.
#
# Mientras estas variables no existan, la aplicación funciona con el almacén
# local del navegador y no toca la base de datos.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# La clave service_role/secret NO se pone aquí de verdad: tiene permisos
# totales y saltaría la seguridad por filas. Solo se usa en las rutas de
# servidor de app/api/**, nunca en el cliente ni con un valor real commiteado.
SUPABASE_SECRET_KEY=

# Notificaciones push (Web Push). Genera el par con:
#   npx web-push generate-vapid-keys
# La pública lleva NEXT_PUBLIC_ porque el navegador la necesita para
# suscribirse; la privada NUNCA debe tener ese prefijo.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hola@unium.fit

# Opcional: protege /api/cron/recordatorios para que solo Vercel Cron pueda
# llamarlo. Pon el mismo valor aquí y en Vercel -> Environment Variables.
CRON_SECRET=
