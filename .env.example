# Credenciales del proyecto de Supabase.
# Copia este archivo como .env.local y pega los valores de
# Supabase -> Project Settings -> API.
#
# Mientras estas variables no existan, la aplicación funciona con el almacén
# local del navegador y no toca la base de datos.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# La clave service_role NO se pone aquí: tiene permisos totales y saltaría la
# seguridad por filas. Solo se usa en un servidor propio, nunca en el cliente
# ni en el repositorio.
